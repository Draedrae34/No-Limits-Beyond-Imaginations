{
    "windowsaistudio.autoCheckFoundrySkill": true,
    "svn.ignoreMissingSvnWarning": true,
    "github.copilot.chat.agentDebugLog.enabled": true,
    "github.copilot.chat.agentDebugLog.fileLogging.enabled": true,
    "chat.imageCarousel.enabled": true,
    "imageCarousel.explorerContextMenu.enabled": true,
    "chat.useCustomizationsInParentRepositories": true,
    "editor.find.closeOnResult": true,
    "terminal.integrated.windowsUseConptyDll": true,
    "geminicodeassist.agentDebugMode": true,
    "geminicodeassist.codeGenerationPaneViewEnabled": true,
    "geminicodeassist.outlines.automaticOutlineGeneration": true,
    "todo-tree.tree.scanMode": "open files",
    "python.testing.unittestArgs": [
        "-v",
        "-s",
        ".",
        "-p",
        "*test*.py"
    ],
    "python.testing.pytestEnabled": false,
    "python.testing.unittestEnabled": true
}