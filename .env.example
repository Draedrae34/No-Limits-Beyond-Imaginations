# No Limits Beyond Limitations - Environment Configuration
# Copy this file to .env and fill in your values

# Stripe API Keys (Get from Stripe Dashboard > Developers > API keys)
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key_here

# Stripe Webhook Secret (Get from Stripe Dashboard > Developers > Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Printify Configuration (Get from Printify Dashboard > Settings > API)
PRINTIFY_API_TOKEN=your_printify_api_token_here
PRINTIFY_SHOP_ID=your_printify_shop_id_here

# Email Configuration (SendGrid)
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
EMAIL_FROM=No Limits Beyond Limitations <no-reply@nolimitsbeyondlimitations.com>
EMAIL_ADMIN=your-admin-email@example.com

# Site Configuration
SITE_URL=https://your-domain.vercel.app

# Vercel Environment
VERCEL_ENV=production

# Optional: Google Analytics
GOOGLE_ANALYTICS_ID=GA_MEASUREMENT_ID_HERE
