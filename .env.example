# NLBL Environment Variables
# Copy this file to .env and fill in your values
# Never commit .env to version control

# Database
DATABASE_URL=postgresql://user:pass@host/db

# Printify
PRINTIFY_API_KEY=your_printify_api_key
PRINTIFY_SHOP_ID=your_shop_id

# PayPal
PAYPAL_CLIENT_ID=your_paypal_client_id
# Optional: PAYPAL_WEBHOOK_ID for webhook verification

# Stripe (not used - PayPal only)
# STRIPE_SECRET_KEY=sk_live_xxx
# STRIPE_PUBLISHABLE_KEY=pk_live_xxx

# Admin authentication
QUANTUM_ADMIN_PASS=your_admin_password
WORKSHOP_PASSWORD=your_workshop_password
WORKSHOP_TEST_PASSWORD=your_workshop_test_password

# Cron secret (for /api/run-routine)
CRON_SECRET=your_random_cron_secret

# Discord alerts (optional but recommended)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Vercel (optional - for monitoring)
VERCEL_PROJECT_ID=your_vercel_project_id
VERCEL_TEAM_ID=your_vercel_team_id

# Node environment
NODE_ENV=production