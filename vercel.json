{
  "version": 2,
  "builds": [
    { "src": "api/*.js", "use": "@vercel/node" },
    { "src": "**/*", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/workshop", "dest": "/jarvis-workshop.html" },
    { "src": "/shop", "dest": "/shop.html" }
  ]
}
