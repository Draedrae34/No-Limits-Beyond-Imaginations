{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.py" },
    { "source": "/workshop/(.*)", "destination": "/private.html" }
  ],
  "functions": {
    "api/*.py": {
      "runtime": "vercel-python@0.0.0"
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "headers": { "cache-control": "no-cache" },
      "dest": "/$1"
    }
  ]
}