{
  "version": 2,
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1.js" },
    
    // Private pages — require auth
    {
      "src": "/workshop",
      "has": [{ "type": "cookie", "key": "nlbl_auth", "value": "authenticated" }],
      "dest": "/public/workshop.html"
    },
    {
      "src": "/workshop",
      "status": 302,
      "headers": { "Location": "/workshop-login.html" }
    },
    {
      "src": "/private",
      "has": [{ "type": "cookie", "key": "nlbl_auth", "value": "authenticated" }],
      "dest": "/public/private.html"
    },
    {
      "src": "/private",
      "status": 302,
      "headers": { "Location": "/workshop-login.html" }
    },
    {
      "src": "/monitor",
      "has": [{ "type": "cookie", "key": "nlbl_auth", "value": "authenticated" }],
      "dest": "/public/monitor.html"
    },
    {
      "src": "/monitor",
      "status": 302,
      "headers": { "Location": "/workshop-login.html" }
    },

    // Public pages — no auth required
    { "src": "/", "dest": "/public/index.html" },
    { "src": "/shop", "dest": "/public/shop.html" },
    { "src": "/remembrance", "dest": "/public/remembrance/remembrance.html" },
    { "src": "/message-wall", "dest": "/public/message-wall.html" },
    { "src": "/brothers-remembrance", "dest": "/public/brothers-remembrance.html" },

    // Static assets & Fallback
    { "src": "/(css/.*|js/.*|img/.*|audio/.*)", "dest": "/public/$1" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
