{
  "version": 2,
  "builds": [
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "css/*.css",
      "use": "@vercel/static"
    },
    {
      "src": "js/*.js",
      "use": "@vercel/static"
    },
    {
      "src": "api/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "textures/*",
      "use": "@vercel/static"
    },
    {
      "src": "remembrance/*",
      "use": "@vercel/static"
    }
  ],
  "functions": {
    "api/*.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/uploads/(.*)", "destination": "/uploads/$1" }
  ],
  "redirects": [
    { "source": "/workshop", "destination": "/jarvis-workshop.html", "permanent": false },
    { "source": "/workshop/", "destination": "/jarvis-workshop.html", "permanent": false },
    { "source": "/shop", "destination": "/final_official_shop.html", "permanent": false },
    { "source": "/shop/", "destination": "/final_official_shop.html", "permanent": false }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, PUT, DELETE, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
