# ===========================================
# NO LIMITS BEYOND LIMITATIONS - Environment Variables
# ===========================================
# Copy this file to .env.local for local development
# Or add these to your Vercel project settings

# -------------------------------------------
# STRIPE (Required for Sales Analytics)
# -------------------------------------------
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# -------------------------------------------
# PRINTIFY (Required for Product Uploads)
# -------------------------------------------
# Get from: https://printify.com/app/integrations/api
PRINTIFY_API_TOKEN=your_printify_api_token_here
PRINTIFY_SHOP_ID=your_printify_shop_id_here

# -------------------------------------------
# GOOGLE ANALYTICS (Optional - for Traffic Data)
# -------------------------------------------
# Get from: https://console.cloud.google.com/apis/credentials
# Create a service account and download the JSON key file
GOOGLE_APPLICATION_CREDENTIALS='{"type":"service_account","project_id":"your-project","private_key":"-----BEGIN PRIVATE KEY-----\nYOUR PRIVATE KEY HERE\n-----END PRIVATE KEY-----\n","client_email":"your-service@project.iam.gserviceaccount.com"}'

# Get from: https://analytics.google.com -> Admin -> Property Settings
GA_PROPERTY_ID=your_ga_property_id_here

# -------------------------------------------
# AUTHENTICATION
# -------------------------------------------
# Generate a secure token: openssl rand -base64 32
NLBL_AUTH_TOKEN=your_secure_auth_token_here

# -------------------------------------------
# OPENAI (Optional - for AI Features)
# -------------------------------------------
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your_openai_key_here

# -------------------------------------------
# DATABASE (Optional)
# -------------------------------------------
# If using a database, add connection string here
# DATABASE_URL=postgresql://user:password@localhost:5432/nlbl
